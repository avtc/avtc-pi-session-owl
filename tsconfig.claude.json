{
  "extends": "./claude/.claude-plugin/types/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    // The vendored core is pi code, byte-copied and checked under the root
    // tsconfig's rules (strict, WITHOUT noUncheckedIndexedAccess). The
    // generated base enables the flag; honoring it here would demand edits
    // to byte-copies and defeat the sync's byte-identity.
    "noUncheckedIndexedAccess": false,
    "paths": {
      "claude-code": ["./claude/.claude-plugin/types/claude-code/index.d.ts"],
      "claude-code-tools": ["./claude/.claude-plugin/types/claude-code-tools/index.d.ts"],
      "claude-code-mcp": ["./claude/.claude-plugin/types/claude-code-mcp/index.d.ts"],
      "typebox": ["./node_modules/typebox/build/index.d.mts"],
      "@earendil-works/pi-ai": ["./node_modules/@earendil-works/pi-ai/dist/index.d.ts"],
      "@earendil-works/pi-agent-core": ["./node_modules/@earendil-works/pi-agent-core/dist/index.d.ts"],
      "@earendil-works/pi-tui": ["./node_modules/@earendil-works/pi-tui/dist/index.d.ts"]
    }
  },
  "include": ["claude/**/*.ts", "claude/**/*.js"],
  "exclude": ["claude/node_modules"]
}
