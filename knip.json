{
  "$schema": "https://unpkg.com/knip@6.17.1/schema.json",
  "entry": [
    "index.ts",
    "scripts/no-optional-params.cjs",
    "scripts/no-bare-literals.cjs",
    "scripts/test-low-priority.cjs",
    "scripts/run-parallel.cjs",
    "scripts/link-dev.mjs",
    "claude/hooks/register.ts",
    "claude/plugin-test/*.test.ts",
    "claude/core/src/log.ts"
  ],
  "project": [
    "index.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.{cjs,mjs,js,ts}",
    "claude/hooks/**/*.{js,ts}",
    "claude/host/**/*.ts",
    "claude/tests/**/*.ts",
    "claude/plugin-test/**/*.ts"
  ],
  "ignore": [
    "**/docs/**",
    "src/**",
    "tests/**"
  ],
  "ignoreDependencies": [
    "avtc-pi-logger",
    "avtc-pi-settings-ui",
    "claude-code"
  ]
}
