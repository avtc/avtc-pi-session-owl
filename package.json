{
  "name": "avtc-pi-session-owl",
  "version": "1.3.0",
  "description": "Background-maintained append-only knowledge graph; roots become the compaction summary; the agent traverses and regex-searches it to recall messages, tool calls, own thinking.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "session",
    "memory",
    "compaction",
    "recall",
    "context",
    "observable",
    "graph",
    "tree",
    "owl"
  ],
  "main": "./index.ts",
  "types": "./index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "allowedCodeDeps": [
      "avtc-pi-logger",
      "avtc-pi-settings-ui"
    ],
    "image": "https://raw.githubusercontent.com/avtc/avtc-pi-session-owl/main/assets/images/cover.png"
  },
  "files": [
    "index.ts",
    "src/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:optional-params": "node scripts/no-optional-params.cjs src/ tests/",
    "lint:bare-literals": "node scripts/no-bare-literals.cjs src/ index.ts",
    "lint:design-refs": "node scripts/no-design-refs.cjs src/ index.ts claude/ README.md docs/CONFIGURATION.md",
    "knip": "knip --production",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc.tsbuildinfo && tsc -p tsconfig.claude.json",
    "test:unit": "node scripts/test-low-priority.cjs vitest run",
    "test": "node scripts/test-low-priority.cjs \"node scripts/run-parallel.cjs \"npm run lint:optional-params :: npm run lint:bare-literals :: npm run lint:design-refs :: npm run lint:as-never :: npm run lint:bundled-imports :: npm run lint :: npm run typecheck :: npm run knip :: npm run dupes :: npm run claude:sync-check :: npm run claude:validate :: npm run smokes :: npm run acceptance:checklist\" && npm run claude:test && vitest run\"",
    "dupes": "jscpd src/ --exit-code --threshold 0.01",
    "lint:as-never": "node scripts/no-as-never.cjs src/ tests/ index.ts",
    "lint:bundled-imports": "node scripts/no-bundled-extension-imports.cjs src/ index.ts",
    "claude:sync": "node scripts/claude-sync.mjs",
    "claude:sync-check": "node scripts/claude-sync.mjs --check",
    "claude:validate": "node scripts/claude-validate.cjs",
    "claude:test": "node scripts/claude-test.cjs",
    "live:smoke": "node scripts/live-smoke.mjs",
    "inertness:smoke": "node scripts/inertness-smoke.mjs",
    "smokes": "node scripts/live-smoke.mjs && node scripts/inertness-smoke.mjs",
    "acceptance:checklist": "node scripts/acceptance-checklist.cjs"
  },
  "dependencies": {
    "avtc-pi-logger": "^1.0.3",
    "avtc-pi-settings-ui": "^1.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^25.9.3",
    "jscpd": "^5.0.10",
    "knip": "^6.17.1",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "avtc-claude-logger": "file:../avtc-pi-logger/claude",
    "avtc-claude-settings-ui": "file:../avtc-pi-settings-ui/claude"
  },
  "author": "avtc <tarasenkov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/avtc/avtc-pi-session-owl.git"
  },
  "bugs": {
    "url": "https://github.com/avtc/avtc-pi-session-owl/issues"
  },
  "homepage": "https://github.com/avtc/avtc-pi-session-owl"
}
